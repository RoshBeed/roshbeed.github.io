# Quarto's execution cache. Nothing writes it: posts are not executed at render
# time, so there is no execution to cache. Ignored so a stray `--execute` run
# cannot commit one.
/_freeze/

# Figures are pulled from the Hub at render time, never committed
posts/*/figures/
